# Binance Square OpenAPI key — required to publish posts
# Get yours at: https://www.binance.com/square/creator-center/home
BINANCE_SQUARE_OPENAPI_KEY=

# Comma-separated list of quote assets to track (default: USDT)
MARKET_QUOTES=USDT

# Number of top movers to include in insights (default: 5)
MARKET_TOP_N=5

# Minimum 24h quote volume to qualify as a notable mover (default: 10000000 = 10M)
MARKET_MIN_VOLUME=10000000

# Binance public API base URL (default: https://api.binance.com)
BINANCE_API_BASE=https://data-api.binance.vision
